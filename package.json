{
  "name": "upvote-club-mcp-apps",
  "version": "2.0.0",
  "description": "Legacy standalone MCP Apps package; the canonical remote server now includes this UI",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "cross-env INPUT=mcp-app.html vite build",
    "start": "node main.js",
    "start:stdio": "node main.js --stdio",
    "dev": "concurrently --raw \"cross-env NODE_ENV=development INPUT=mcp-app.html vite build --watch\" \"node main.js\"",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Upvote.club <yes@upvote.club>",
  "license": "MIT",
  "homepage": "https://upvote.club/api",
  "repository": {
    "type": "git",
    "url": "https://github.com/upvoteclub/upvote-club-mcp-apps.git"
  },
  "bugs": {
    "url": "https://github.com/upvoteclub/upvote-club-mcp-core/issues"
  },
  "dependencies": {
    "@upvote-club/mcp-core": "github:upvoteclub/upvote-club-mcp-core",
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.1.0"
  }
}
